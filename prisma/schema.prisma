generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================== USER MANAGEMENT ==================
model users {
  id            String   @id @default(cuid())
  username      String   @unique @db.VarChar(50)
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  is_active     Boolean  @default(true)
  role_id       String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  role            roles?               @relation(fields: [role_id], references: [id], onDelete: SetNull)
  employee        employees?
  purchase_orders purchase_orders[]
  notifications   notifications[]
  activity_logs   user_activity_logs[]

  @@map("users")
}

model permission_groups {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions permission[]

  @@map("permission_groups")
}

model permission {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  group_id    String
  group       permission_groups  @relation(fields: [group_id], references: [id])
  roles       role_permissions[]

  @@map("permissions")
}

model roles {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  is_active   Boolean            @default(true)
  created_at  DateTime           @default(now())
  updated_at  DateTime           @default(now())
  permissions role_permissions[]
  users       users[]

  @@map("roles")
}

model role_permissions {
  id            String @id @default(cuid())
  role_id       String
  permission_id String

  role       roles      @relation(fields: [role_id], references: [id])
  permission permission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model notifications {
  id         String    @id @default(cuid())
  user_id    String
  title      String    @db.VarChar(255)
  message    String    @db.Text
  type       String    @default("info") @db.VarChar(20)
  is_read    Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  read_at    DateTime? @db.Timestamptz(6)

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

model user_activity_logs {
  id         String   @id @default(cuid())
  user_id    String
  action     String   @db.VarChar(100)
  entity     String?  @db.VarChar(50)
  entity_id  String?  @db.VarChar(50)
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.Text
  metadata   Json?    @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([entity, entity_id])
  @@map("user_activity_logs")
}

// ================== EMPLOYEE MANAGEMENT ==================
model employees {
  id              String    @id @default(cuid())
  employee_number String    @unique @db.VarChar(20)
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  phone           String?   @unique @db.VarChar(20)
  nic             String?   @unique @db.VarChar(20)
  gender          gender?
  position        String?   @db.VarChar(100)
  department      String?   @db.VarChar(50)
  date_of_birth   DateTime? @db.Date
  hire_date       DateTime? @db.Date
  branch_id       String?
  is_active       Boolean   @default(true)
  user_id         String?   @unique
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  user                users?                    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  branch              branches?                 @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  requested_transfers stock_transfer_requests[] @relation("RequestedBy")
  approved_transfers  stock_transfer_requests[] @relation("ApprovedBy")
  stock_transfer_logs stock_transfer_logs[]
  stock_adjustments   stock_adjustments[]       @relation("AdjustedBy")
  price_overrides     price_overrides[]         @relation("ApprovedBy")
  price_changes       product_price_history[]   @relation("CreatedBy")
  purchase_batches    purchase_batches[]        @relation("ReceivedBy") // <-- Add this line
  items_sold          item_barcodes[]           @relation("SoldBy")
  items_returned      item_barcodes[]           @relation("ReturnedBy")
  item_movements      item_movement_history[]

  @@index([employee_number])
  @@index([email])
  @@index([branch_id])
  @@map("employees")
}

enum gender {
  MALE
  FEMALE
  OTHER
}

// ================== PRODUCT CATEGORIES ==================
model categories {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  subcategories subcategories[]

  @@map("categories")
}

model subcategories {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  category_id String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  products products[]

  @@index([category_id])
  @@map("subcategories")
}

// ================== PRODUCT SPECIFICATIONS ==================
model product_specifications {
  id         String   @id @default(cuid())
  product_id String
  spec_name  String   @db.VarChar(100)
  spec_value String   @db.VarChar(255)
  spec_unit  String?  @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([spec_name])
  @@map("product_specifications")
}

// ================== BRANDS ==================
model brands {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(10)
  description String?  @db.Text
  logo_url    String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  products products[]

  @@index([code])
  @@map("brands")
}

// ================== PRODUCTS ==================
model products {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(255)
  model           String   @db.VarChar(255)
  description     String?  @db.Text
  subcategory_id  String?
  brand_id        String?
  sku             String   @unique @db.VarChar(50)
  warranty_period Int? // in months
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  brand                 brands?                  @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  subcategory           subcategories?           @relation(fields: [subcategory_id], references: [id], onDelete: SetNull)
  specifications        product_specifications[]
  purchase_order_items  purchase_order_items[]
  sales_order_items     sales_order_items[]
  branch_inventory      branch_inventory[]
  barcodes              barcodes[]
  stock_ledgers         product_stock_ledgers[]
  stock_transfer_items  stock_transfer_items[]
  stock_adjustments     stock_adjustments[]      @relation("ProductVariation")
  purchase_return_items purchase_return_items[]
  sales_return_items    sales_return_items[]
  low_stock_alerts      low_stock_alerts[]
  price_history         product_price_history[]
  price_overrides       price_overrides[]
  current_prices        product_current_prices?
  item_barcodes         item_barcodes[] // Individual tracked items

  @@index([subcategory_id])
  @@index([brand_id])
  @@index([name])
  @@index([sku])
  @@map("products")
}

// ================== NEW: DYNAMIC PRICING SYSTEM ==================
model product_price_history {
  id              String   @id @default(cuid())
  product_id      String
  effective_date  DateTime @db.Timestamptz(6)
  cost_price      Decimal  @db.Decimal(10, 2)
  wholesale_price Decimal? @db.Decimal(10, 2)
  retail_price    Decimal  @db.Decimal(10, 2)
  is_active       Boolean  @default(true)
  created_by      String
  reason          String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  product             products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_by_employee employees @relation("CreatedBy", fields: [created_by], references: [id])

  @@index([product_id, effective_date])
  @@index([effective_date, is_active])
  @@index([product_id, is_active])
  @@map("product_price_history")
}

// NEW: Current active prices view for quick access
model product_current_prices {
  product_id      String   @id
  cost_price      Decimal  @db.Decimal(10, 2)
  wholesale_price Decimal? @db.Decimal(10, 2)
  retail_price    Decimal  @db.Decimal(10, 2)
  last_updated    DateTime @db.Timestamptz(6)

  // Relations
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_current_prices")
}

// NEW: Price override system
model price_overrides {
  id             String     @id @default(cuid())
  product_id     String
  branch_id      String
  override_price Decimal    @db.Decimal(10, 2)
  original_price Decimal    @db.Decimal(10, 2)
  price_type     price_type @default(RETAIL) // RETAIL, WHOLESALE
  reason         String     @db.Text
  valid_from     DateTime   @db.Timestamptz(6)
  valid_until    DateTime?  @db.Timestamptz(6)
  approved_by    String
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)

  // Relations
  product  products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  branch   branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  approver employees @relation("ApprovedBy", fields: [approved_by], references: [id])

  @@index([product_id, branch_id, is_active])
  @@index([valid_from, valid_until])
  @@map("price_overrides")
}

model barcodes {
  id         String       @id @default(cuid())
  product_id String
  code       String       @unique @db.VarChar(50)
  type       barcode_type @default(INTERNAL)
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now()) @db.Timestamptz(6)

  // Relations
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("barcodes")
}

model item_barcodes {
  id                String         @id @default(cuid())
  purchase_batch_id String
  product_id        String // Added for easier querying
  code              String         @unique @db.VarChar(50)
  type              barcode_type   @default(INTERNAL)
  status            barcode_status @default(AVAILABLE)

  purchased_at  DateTime @default(now()) @db.Timestamptz(6)
  purchase_cost Decimal  @db.Decimal(10, 2)
  supplier_id   String? // Track original supplier

  sales_order_item_id String?
  sold_at             DateTime? @db.Timestamptz(6)
  sold_price          Decimal?  @db.Decimal(10, 2)
  sold_to_customer    String? // Customer ID
  sold_by_employee    String? // Employee who sold it

  returned_at   DateTime? @db.Timestamptz(6)
  return_reason String?   @db.Text
  returned_by   String? // Employee who processed return

  warranty_expiry DateTime?      @db.Date
  condition       item_condition @default(GOOD)
  location_branch String? // Current branch location
  notes           String?        @db.Text
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @updatedAt @db.Timestamptz(6)

  purchase_batch        purchase_batches        @relation(fields: [purchase_batch_id], references: [id], onDelete: Cascade)
  product               products                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplier              suppliers?              @relation(fields: [supplier_id], references: [id])
  sales_order_item      sales_order_items?      @relation(fields: [sales_order_item_id], references: [id])
  customer              customers?              @relation(fields: [sold_to_customer], references: [id])
  sold_by               employees?              @relation("SoldBy", fields: [sold_by_employee], references: [id])
  returned_by_emp       employees?              @relation("ReturnedBy", fields: [returned_by], references: [id])
  current_branch        branches?               @relation(fields: [location_branch], references: [id])
  item_movement_history item_movement_history[]

  @@index([purchase_batch_id])
  @@index([product_id])
  @@index([status])
  @@index([sold_at])
  @@index([purchased_at])
  @@index([supplier_id])
  @@index([sold_to_customer])
  @@index([location_branch])
  @@map("item_barcodes")
}

model item_movement_history {
  id            String             @id @default(cuid())
  item_id       String // item_barcodes.id
  from_branch   String?
  to_branch     String?
  movement_type item_movement_type
  reference_id  String? // Purchase order, sales order, transfer request ID
  moved_by      String? // Employee ID
  reason        String?            @db.Text
  moved_at      DateTime           @default(now()) @db.Timestamptz(6)

  item     item_barcodes @relation(fields: [item_id], references: [id], onDelete: Cascade)
  from_br  branches?     @relation("FromBranch", fields: [from_branch], references: [id])
  to_br    branches?     @relation("ToBranch", fields: [to_branch], references: [id])
  employee employees?    @relation(fields: [moved_by], references: [id])

  @@index([item_id])
  @@index([moved_at])
  @@index([movement_type])
  @@map("item_movement_history")
}

model purchase_batches {
  id                     String    @id @default(cuid())
  batch_number           String?   @unique @db.VarChar(50)
  purchase_order_item_id String    @unique
  quantity_ordered       Int
  quantity_received      Int       @default(0)
  cost_price             Decimal   @db.Decimal(10, 2)
  wholesale_price        Decimal?  @db.Decimal(10, 2)
  retail_price           Decimal   @db.Decimal(10, 2)
  expiry_date            DateTime? @db.Date
  received_date          DateTime? @db.Date
  received_by            String? // NEW: Track who received this batch
  is_active              Boolean   @default(true)
  fifo_sequence          Int? // NEW: For FIFO ordering
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  purchase_order_item     purchase_order_items      @relation("OrderItemToBatch", fields: [purchase_order_item_id], references: [id], onDelete: Cascade)
  receiver                employees?                @relation("ReceivedBy", fields: [received_by], references: [id])
  inventory_items         branch_inventory_items[]
  product_stock_ledgers   product_stock_ledgers[]
  sales_batch_allocations sales_batch_allocations[] // NEW: Track sales from this batch
  item_barcodes           item_barcodes[]

  @@index([batch_number])
  @@index([expiry_date])
  @@index([fifo_sequence]) // NEW: For FIFO queries
  @@index([received_date])
  @@map("purchase_batches")
}

// ================== ENHANCED FIFO SUPPORT ==================
// NEW: Track which batches are used in each sale
model sales_batch_allocations {
  id                  String   @id @default(cuid())
  sales_order_item_id String
  batch_id            String
  quantity_allocated  Int
  cost_price_at_sale  Decimal  @db.Decimal(10, 2)
  selling_price       Decimal  @db.Decimal(10, 2)
  allocated_at        DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  sales_order_item sales_order_items @relation(fields: [sales_order_item_id], references: [id], onDelete: Cascade)
  batch            purchase_batches  @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@unique([sales_order_item_id, batch_id])
  @@index([batch_id])
  @@index([allocated_at])
  @@map("sales_batch_allocations")
}

// ================== BRANCH & INVENTORY MANAGEMENT ==================
model branches {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(100)
  code           String   @unique @db.VarChar(10)
  location       String?  @db.VarChar(255)
  address        String?  @db.Text
  phone          String?  @unique @db.VarChar(20)
  email          String?  @unique @db.VarChar(255)
  is_active      Boolean  @default(true)
  is_main_branch Boolean  @default(false)
  can_purchase   Boolean  @default(false)
  timezone       String   @default("UTC") @db.VarChar(50)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  employees              employees[]
  sales_orders           sales_orders[]
  purchase_orders        purchase_orders[]
  from_transfer_requests stock_transfer_requests[] @relation("FromBranch")
  to_transfer_requests   stock_transfer_requests[] @relation("ToBranch")
  inventory              branch_inventory[]
  stock_adjustments      stock_adjustments[]       @relation("Branch")
  stock_ledgers          product_stock_ledgers[]
  low_stock_alerts       low_stock_alerts[]
  price_overrides        price_overrides[]
  current_items          item_barcodes[] // Items currently in this branch
  movements_from         item_movement_history[]   @relation("FromBranch")
  movements_to           item_movement_history[]   @relation("ToBranch")

  @@index([code])
  @@index([is_main_branch])
  @@index([can_purchase])
  @@map("branches")
}

// ================== PRICE TRACKING ==================
model product_stock_ledgers {
  id             String           @id @default(cuid())
  product_id     String
  branch_id      String
  batch_id       String?
  quantity       Int
  entry_type     stock_entry_type
  reference_id   String?          @db.VarChar(50)
  reference_type String?          @db.VarChar(50)
  cost_price     Decimal?         @db.Decimal(10, 2) // NEW: Track cost at time of entry
  selling_price  Decimal?         @db.Decimal(10, 2) // NEW: Track selling price
  notes          String?          @db.Text
  created_at     DateTime         @default(now()) @db.Timestamptz(6)

  // Relations
  product products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  branch  branches          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  batch   purchase_batches? @relation(fields: [batch_id], references: [id])

  @@index([product_id, created_at])
  @@index([branch_id, created_at])
  @@index([batch_id])
  @@index([reference_type, reference_id])
  @@index([entry_type, created_at])
  @@map("product_stock_ledgers")
}

model branch_inventory_items {
  id                  String    @id @default(cuid())
  branch_inventory_id String
  purchase_batch_id   String
  quantity            Int       @default(0)
  reserved_quantity   Int       @default(0)
  cost_price          Decimal   @db.Decimal(10, 2)
  wholesale_price     Decimal?  @db.Decimal(10, 2)
  retail_price        Decimal   @db.Decimal(10, 2)
  received_date       DateTime  @db.Timestamptz(6)
  expiry_date         DateTime? @db.Date
  is_active           Boolean   @default(true)
  fifo_order          Int? // NEW: For FIFO processing
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  branch_inventory branch_inventory @relation(fields: [branch_inventory_id], references: [id], onDelete: Cascade)
  purchase_batch   purchase_batches @relation(fields: [purchase_batch_id], references: [id], onDelete: Cascade)

  @@unique([branch_inventory_id, purchase_batch_id])
  @@index([branch_inventory_id])
  @@index([purchase_batch_id])
  @@index([quantity])
  @@index([expiry_date])
  @@index([fifo_order]) // NEW: For FIFO queries
  @@map("branch_inventory_items")
}

model branch_inventory {
  id                      String    @id @default(cuid())
  branch_id               String
  product_id              String
  total_quantity          Int       @default(0)
  reserved_quantity       Int       @default(0)
  low_stock_threshold     Int       @default(5)
  reorder_quantity        Int       @default(20)
  last_restock_date       DateTime? @db.Timestamptz(6)
  last_sale_date          DateTime? @db.Timestamptz(6)
  last_counted_at         DateTime? @db.Timestamptz(6)
  is_low_stock_alert_sent Boolean   @default(false)
  average_cost_price      Decimal?  @db.Decimal(10, 2) // NEW: Weighted average cost
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  branch  branches                 @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product products                 @relation(fields: [product_id], references: [id], onDelete: Cascade)
  items   branch_inventory_items[]

  @@unique([branch_id, product_id])
  @@index([branch_id])
  @@index([product_id])
  @@index([total_quantity])
  @@index([branch_id, total_quantity])
  @@map("branch_inventory")
}

// ================== LOW STOCK ALERT SYSTEM ==================
model low_stock_alerts {
  id              String               @id @default(cuid())
  branch_id       String
  product_id      String
  current_stock   Int
  threshold_level Int
  alert_type      low_stock_alert_type @default(LOW_STOCK)
  status          alert_status         @default(ACTIVE)
  notified_at     DateTime?            @db.Timestamptz(6)
  resolved_at     DateTime?            @db.Timestamptz(6)
  notes           String?              @db.Text
  created_at      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at      DateTime             @default(now()) @db.Timestamptz(6)

  // Relations
  branch  branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([branch_id, status])
  @@index([product_id, status])
  @@index([alert_type, status])
  @@map("low_stock_alerts")
}

// ================== STOCK OPERATIONS ==================
model stock_transfer_requests {
  id             String          @id @default(cuid())
  request_number String          @unique @db.VarChar(20)
  from_branch_id String
  to_branch_id   String
  requested_by   String
  approved_by    String?
  status         transfer_status @default(PENDING)
  priority       priority_level  @default(NORMAL)
  request_reason String?         @db.Text
  notes          String?         @db.Text
  requested_at   DateTime        @default(now()) @db.Timestamptz(6)
  approved_at    DateTime?       @db.Timestamptz(6)
  dispatched_at  DateTime?       @db.Timestamptz(6)
  completed_at   DateTime?       @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)

  // Relations
  from_branch branches               @relation("FromBranch", fields: [from_branch_id], references: [id])
  to_branch   branches               @relation("ToBranch", fields: [to_branch_id], references: [id])
  requester   employees              @relation("RequestedBy", fields: [requested_by], references: [id])
  approver    employees?             @relation("ApprovedBy", fields: [approved_by], references: [id])
  items       stock_transfer_items[]
  logs        stock_transfer_logs[]

  @@index([request_number])
  @@index([from_branch_id])
  @@index([to_branch_id])
  @@index([status])
  @@index([requested_at])
  @@map("stock_transfer_requests")
}

model stock_transfer_items {
  id                   String   @id @default(cuid())
  transfer_request_id  String
  product_id           String
  batch_id             String?
  quantity_requested   Int
  quantity_approved    Int?
  quantity_dispatched  Int?
  quantity_received    Int?
  unit_cost_price      Decimal  @db.Decimal(10, 2)
  unit_wholesale_price Decimal? @db.Decimal(10, 2)
  unit_retail_price    Decimal  @db.Decimal(10, 2)
  notes                String?  @db.Text
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  transfer_request stock_transfer_requests @relation(fields: [transfer_request_id], references: [id], onDelete: Cascade)
  product          products                @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model stock_transfer_logs {
  id                  String          @id @default(cuid())
  transfer_request_id String
  employee_id         String
  action_type         transfer_status
  notes               String?         @db.Text
  metadata            Json?           @default("{}")
  created_at          DateTime        @default(now()) @db.Timestamptz(6)

  // Relations
  transfer_request stock_transfer_requests @relation(fields: [transfer_request_id], references: [id], onDelete: Cascade)
  employee         employees               @relation(fields: [employee_id], references: [id])

  @@index([transfer_request_id])
  @@index([employee_id])
  @@map("stock_transfer_logs")
}

model stock_adjustments {
  id                String            @id @default(cuid())
  adjustment_number String            @unique @db.VarChar(20)
  branch_id         String
  product_id        String
  quantity_before   Int
  quantity_after    Int
  quantity_change   Int
  reason            adjustment_reason
  notes             String?           @db.Text
  adjusted_by       String
  approved_by       String?
  adjustment_date   DateTime          @default(now()) @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)

  // Relations
  branch   branches  @relation("Branch", fields: [branch_id], references: [id])
  product  products  @relation("ProductVariation", fields: [product_id], references: [id])
  adjuster employees @relation("AdjustedBy", fields: [adjusted_by], references: [id])

  @@index([adjustment_number])
  @@index([branch_id])
  @@index([product_id])
  @@map("stock_adjustments")
}

// ================== SUPPLIER & PURCHASE MANAGEMENT ==================
model suppliers {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(100)
  code            String   @unique @db.VarChar(10)
  contact_name    String?  @db.VarChar(100)
  phone           String?  @db.VarChar(20)
  email           String?  @db.VarChar(255)
  address         String?  @db.Text
  sales_rep_name  String   @db.VarChar(100)
  sales_rep_phone String?  @db.VarChar(20)
  payment_terms   String?  @db.VarChar(100)
  credit_limit    Decimal? @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  purchase_orders purchase_orders[]
  item_barcodes   item_barcodes[] // Track items from this supplier

  @@index([code])
  @@index([name])
  @@map("suppliers")
}

model purchase_orders {
  id            String       @id @default(cuid())
  order_number  String       @unique @db.VarChar(20)
  invoice_number  String?
  supplier_id   String
  purchased_by  String?
  branch_id     String?
  order_date    DateTime     @default(now()) @db.Date
  expected_date DateTime?    @db.Date
  received_date DateTime?    @db.Date
  status        order_status @default(PENDING)
  subtotal      Decimal?     @default(0) @db.Decimal(12, 2)
  tax_amount    Decimal?     @default(0) @db.Decimal(10, 2)
  total_amount  Decimal?     @default(0) @db.Decimal(12, 2)
  notes         String?      @db.Text
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)

  // Relations
  supplier suppliers              @relation(fields: [supplier_id], references: [id])
  user     users?                 @relation(fields: [purchased_by], references: [id])
  branch   branches?              @relation(fields: [branch_id], references: [id])
  items    purchase_order_items[]
  returns  purchase_returns[]

  @@index([order_number])
  @@index([supplier_id])
  @@index([branch_id])
  @@index([status])
  @@map("purchase_orders")
}

model purchase_order_items {
  id                String    @id @default(cuid())
  purchase_order_id String
  product_id        String
  quantity_ordered  Int
  quantity_received Int       @default(0)
  cost_price        Decimal   @db.Decimal(10, 2)
  wholesale_price   Decimal?  @db.Decimal(10, 2)
  retail_price      Decimal   @db.Decimal(10, 2)
  line_total        Decimal   @db.Decimal(12, 2)
  batch_number      String?   @db.VarChar(50)
  expiry_date       DateTime? @db.Date
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  purchase_order purchase_orders   @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product        products          @relation(fields: [product_id], references: [id])
  batch          purchase_batches? @relation("OrderItemToBatch")

  @@unique([purchase_order_id, product_id])
  @@map("purchase_order_items")
}

model purchase_returns {
  id                String        @id @default(cuid())
  return_number     String        @unique @db.VarChar(20)
  purchase_order_id String
  returned_by       String
  return_date       DateTime      @default(now()) @db.Date
  reason            String?       @db.Text
  total_amount      Decimal       @default(0) @db.Decimal(12, 2)
  status            return_status @default(PENDING)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  purchase_order purchase_orders         @relation(fields: [purchase_order_id], references: [id])
  items          purchase_return_items[]

  @@index([return_number])
  @@index([purchase_order_id])
  @@map("purchase_returns")
}

model purchase_return_items {
  id                 String   @id @default(cuid())
  purchase_return_id String
  product_id         String
  batch_id           String? // NEW: Track which batch is being returned
  quantity           Int
  cost_price         Decimal  @db.Decimal(10, 2)
  line_total         Decimal  @db.Decimal(12, 2)
  reason             String?  @db.Text
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  purchase_return purchase_returns @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade)
  product         products         @relation(fields: [product_id], references: [id])

  @@unique([purchase_return_id, product_id])
  @@map("purchase_return_items")
}

// ================== CUSTOMER & SALES MANAGEMENT ==================
model customers {
  id                  String        @id @default(cuid())
  customer_number     String        @unique @db.VarChar(20)
  name                String        @db.VarChar(100)
  email               String?       @unique @db.VarChar(255)
  nic                 String?       @unique @db.VarChar(20)
  phone               String?       @unique @db.VarChar(20)
  address             String?       @db.Text
  date_of_birth       DateTime?     @db.Date
  customer_type       customer_type @default(RETAIL) // NEW: Customer type for pricing
  credit_limit        Decimal?      @db.Decimal(12, 2)
  outstanding_balance Decimal       @default(0) @db.Decimal(12, 2)
  loyalty_points      Int           @default(0)
  discount_percentage Decimal?      @db.Decimal(5, 2) // NEW: Customer-specific discount
  is_active           Boolean       @default(true)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @default(now()) @db.Timestamptz(6)

  // Relations
  sales_orders    sales_orders[]
  purchased_items item_barcodes[] // Track items sold to this customer

  @@index([customer_number])
  @@index([phone])
  @@index([email])
  @@index([customer_type])
  @@map("customers")
}

model sales_orders {
  id             String          @id @default(cuid())
  order_number   String          @unique @db.VarChar(20)
  customer_id    String?
  branch_id      String
  sold_by        String?
  order_date     DateTime        @default(now()) @db.Date
  delivery_date  DateTime?       @db.Date
  status         order_status    @default(PENDING)
  payment_method payment_method?
  payment_status payment_status  @default(PENDING)
  subtotal       Decimal         @default(0) @db.Decimal(12, 2)
  total_amount   Decimal         @default(0) @db.Decimal(12, 2)
  discount       Decimal         @default(0) @db.Decimal(10, 2)
  total_cost     Decimal?        @default(0) @db.Decimal(12, 2) // NEW: Total cost for profit calculation
  profit_amount  Decimal?        @default(0) @db.Decimal(12, 2) // NEW: Calculated profit
  notes          String?         @db.Text
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @updatedAt @db.Timestamptz(6)

  // Relations
  customer customers?          @relation(fields: [customer_id], references: [id])
  branch   branches            @relation(fields: [branch_id], references: [id])
  items    sales_order_items[]
  returns  sales_returns[]

  @@index([order_number])
  @@index([customer_id])
  @@index([branch_id])
  @@index([status])
  @@index([order_date])
  @@map("sales_orders")
}

model sales_order_items {
  id              String    @id @default(cuid())
  sales_order_id  String
  product_id      String
  quantity        Int
  unit_price      Decimal   @db.Decimal(10, 2) // Selling price
  discount        Decimal   @default(0) @db.Decimal(10, 2)
  line_total      Decimal   @db.Decimal(12, 2)
  line_cost       Decimal?  @db.Decimal(12, 2) // NEW: Total cost for this line
  line_profit     Decimal?  @db.Decimal(12, 2) // NEW: Profit for this line
  warranty_expiry DateTime? @db.Date
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  sales_order       sales_orders              @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  product           products                  @relation(fields: [product_id], references: [id])
  batch_allocations sales_batch_allocations[] // NEW: FIFO batch allocations
  item_barcodes     item_barcodes[] // Track individual items sold

  @@unique([sales_order_id, product_id])
  @@index([product_id])
  @@map("sales_order_items")
}

model sales_returns {
  id             String        @id @default(cuid())
  return_number  String        @unique @db.VarChar(20)
  sales_order_id String
  returned_by    String
  return_date    DateTime      @default(now()) @db.Date
  reason         String?       @db.Text
  total_amount   Decimal       @default(0) @db.Decimal(12, 2)
  status         return_status @default(PENDING)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  sales_order sales_orders         @relation(fields: [sales_order_id], references: [id])
  items       sales_return_items[]

  @@index([return_number])
  @@index([sales_order_id])
  @@map("sales_returns")
}

model sales_return_items {
  id              String   @id @default(cuid())
  sales_return_id String
  product_id      String
  batch_id        String? // NEW: Track which batch is being returned
  quantity        Int
  unit_price      Decimal  @db.Decimal(10, 2)
  line_total      Decimal  @db.Decimal(12, 2)
  reason          String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  sales_return sales_returns @relation(fields: [sales_return_id], references: [id], onDelete: Cascade)
  product      products      @relation(fields: [product_id], references: [id])

  @@unique([sales_return_id, product_id])
  @@map("sales_return_items")
}

