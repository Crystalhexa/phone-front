generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================== USER MANAGEMENT ==================
model users {
  id            String              @id @default(cuid())
  username      String              @unique @db.VarChar(50)
  email         String              @unique @db.VarChar(255)
  password_hash String              @db.VarChar(255)
  is_active     Boolean             @default(true)
  role_id       String?
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @default(now()) @db.Timestamptz(6)
  
  // Relations
  role            roles?               @relation(fields: [role_id], references: [id], onDelete: SetNull)
  employee        employees?
  purchase_orders purchase_orders[]
  notifications   notifications[]
  activity_logs   user_activity_logs[]

  @@map("users")
}

model permission_groups {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  permissions permission[]

  @@map("permission_groups")
}

model permission {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  group_id     String
  group       permission_groups @relation(fields: [group_id], references: [id])
  roles       role_permissions[]

  @@map("permissions")
}

model roles {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  is_active   Boolean        @default(true)
  created_at  DateTime       @default(now())
  updated_at  DateTime        @default(now())
  permissions role_permissions[]
  users       users[]

  @@map("roles")
}

model role_permissions {
  id           String      @id @default(cuid())
  role_id       String
  permission_id String

  role         roles       @relation(fields: [role_id], references: [id])
  permission   permission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}


model notifications {
  id         String   @id @default(cuid())
  user_id    String
  title      String   @db.VarChar(255)
  message    String   @db.Text
  type       String   @default("info") @db.VarChar(20)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  read_at    DateTime? @db.Timestamptz(6)

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

model user_activity_logs {
  id         String   @id @default(cuid())
  user_id    String
  action     String   @db.VarChar(100)
  entity     String?  @db.VarChar(50)
  entity_id  String?  @db.VarChar(50)
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.Text
  metadata   Json?    @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([entity, entity_id])
  @@map("user_activity_logs")
}

// ================== EMPLOYEE MANAGEMENT ==================
model employees {
  id              String    @id @default(cuid())
  employee_number String    @unique @db.VarChar(20)
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  phone           String?   @unique @db.VarChar(20)
  nic             String?   @unique @db.VarChar(20)
  gender          gender?
  position        String?   @db.VarChar(100)
  department      String?   @db.VarChar(50)
  date_of_birth   DateTime? // <- New field
  hire_date       DateTime? // <- New field
  is_active       Boolean   @default(true)
  user_id         String?   @unique
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  
  // Relations
  user                    users?                   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  requested_transfers     stock_transfer_requests[] @relation("RequestedBy")
  dispatched_deliveries   deliveries[]             @relation("DispatchedBy")
  received_deliveries     deliveries[]             @relation("ReceivedBy")
  stock_transfer_logs     stock_transfer_logs[]
  stock_adjustments       stock_adjustments[]      @relation("AdjustedBy")

  @@index([employee_number])
  @@index([email])
  @@map("employees")
}


enum gender {
  MALE
  FEMALE
  OTHER
}

// ================== CATEGORY & BRAND MANAGEMENT ==================
model categories {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  
  // Relations
  subcategories subcategories[]

  @@map("categories")
}

model subcategories {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  category_id String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  products products[]

  @@index([category_id])
  @@map("subcategories")
}

model brands {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(10)
  description String?  @db.Text
  logo_url    String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  
  // Relations
  products products[]

  @@index([code])
  @@map("brands")
}

// ================== PRODUCT CATALOG ==================
model products {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  subcategory_id  String?
  brand_id        String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  brand                brands?              @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  subcategory          subcategories?       @relation(fields: [subcategory_id], references: [id], onDelete: SetNull)
  attributes           product_attributes[]
  variations           product_variations[]

  @@index([subcategory_id])
  @@index([brand_id])
  @@index([name])
  @@map("products")
}

model product_variations {
  id                     String    @id @default(cuid())
  product_id             String
  sku                    String    @unique @db.VarChar(50)
  name                   String?   @db.VarChar(255)
  cost_price             Decimal   @default(0) @db.Decimal(10, 2)
  wholesale_price        Decimal?  @db.Decimal(10, 2)
  retail_price           Decimal   @db.Decimal(10, 2)
  stock_quantity         Int       @default(0)
  low_stock_threshold    Int       @default(5)
  warranty_period        Int?      // in months
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  product                    products                       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attributes                 product_variation_attributes[]
  serial_numbers             serial_numbers[]
  purchase_order_items       purchase_order_items[]
  sales_order_items          sales_order_items[]
  branch_inventory           branch_inventory[]
  images                     product_images[]
  barcodes                   barcodes[]
  price_history              product_price_history[]
  stock_ledgers              product_stock_ledgers[]
  batches                    product_batches[]
  stock_transfer_items       stock_transfer_items[]
  stock_adjustments          stock_adjustments[]            @relation("ProductVariation")
  purchase_return_items      purchase_return_items[]
  sales_return_items         sales_return_items[]

  @@index([product_id])
  @@index([sku])
  @@index([stock_quantity])
  @@map("product_variations")
}

model attributes {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  
  // Relations
  values                   attribute_values[]
  product_attributes       product_attributes[]
  variation_attributes     product_variation_attributes[]

  @@map("attributes")
}

model attribute_values {
  id           String   @id @default(cuid())
  attribute_id String
  value        String   @unique @db.VarChar(100) 
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  
  // Relations
  attribute            attributes                     @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  variation_attributes product_variation_attributes[]

  @@unique([attribute_id, value])
  @@index([attribute_id])
  @@map("attribute_values")
}

model product_attributes {
  id           String   @id @default(cuid())
  product_id   String
  attribute_id String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  product   products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attribute attributes @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@unique([product_id, attribute_id])
  @@map("product_attributes")
}

model product_variation_attributes {
  id                 String   @id @default(cuid())
  variation_id       String
  attribute_id       String
  attribute_value_id String
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  variation       product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)
  attribute       attributes         @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  attribute_value attribute_values   @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade)

  @@unique([variation_id, attribute_id])
  @@map("product_variation_attributes")
}

model product_images {
  id           String   @id @default(cuid())
  variation_id String
  image_url    String   @db.VarChar(500)
  alt_text     String?  @db.VarChar(255)
  is_primary   Boolean  @default(false)
  file_size    Int?     // in bytes
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  variation product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)

  @@index([variation_id])
  @@map("product_images")
}

model barcodes {
  id           String       @id @default(cuid())
  variation_id String
  code         String       @unique @db.VarChar(50)
  type         barcode_type @default(INTERNAL)
  is_active    Boolean      @default(true)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)

  // Relations
  variation product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)

  @@index([variation_id])
  @@map("barcodes")
}

model serial_numbers {
  id           String        @id @default(cuid())
  variation_id String
  serial       String        @unique @db.VarChar(100)
  status       serial_status @default(AVAILABLE)
  sold_at      DateTime?     @db.Timestamptz(6)
  returned_at  DateTime?     @db.Timestamptz(6)
  notes        String?       @db.Text
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  variation product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)

  @@index([variation_id, status])
  @@map("serial_numbers")
}

model product_batches {
  id           String    @id @default(cuid())
  variation_id String
  batch_number String    @db.VarChar(50)
  expiry_date  DateTime? @db.Date
  stock        Int       @default(0)
  cost_price   Decimal   @db.Decimal(10, 2)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  variation product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)

  @@unique([variation_id, batch_number])
  @@index([expiry_date])
  @@map("product_batches")
}

model product_price_history {
  id              String   @id @default(cuid())
  variation_id    String
  cost_price      Decimal  @db.Decimal(10, 2)
  wholesale_price Decimal? @db.Decimal(10, 2)
  retail_price    Decimal  @db.Decimal(10, 2)
  effective_date  DateTime @default(now()) @db.Timestamptz(6)
  changed_by      String?
  reason          String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  variation product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)

  @@index([variation_id, effective_date])
  @@map("product_price_history")
}

model product_stock_ledgers {
  id             String           @id @default(cuid())
  variation_id   String
  branch_id      String?
  quantity       Int
  cost_price     Decimal          @db.Decimal(10, 2)
  entry_type     stock_entry_type
  reference_id   String?          @db.VarChar(50)
  reference_type String?          @db.VarChar(50)
  notes          String?          @db.Text
  created_at     DateTime         @default(now()) @db.Timestamptz(6)

  // Relations
  variation product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)
  branch    branches?          @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@index([variation_id, created_at])
  @@index([branch_id, created_at])
  @@index([reference_type, reference_id])
  @@map("product_stock_ledgers")
}

// ================== BRANCH & INVENTORY MANAGEMENT ==================
model branches {
  id                     String   @id @default(cuid())
  name                   String   @db.VarChar(100)
  code                   String   @unique @db.VarChar(10)
  location               String?  @db.VarChar(255)
  address                String?  @db.Text
  phone                  String?  @unique @db.VarChar(20)
  email                  String?  @unique @db.VarChar(255)
  manager_name           String?  @db.VarChar(100)
  is_active              Boolean  @default(true)
  is_main_branch         Boolean  @default(false)
  timezone               String   @default("UTC") @db.VarChar(50)
  operating_hours        Json?    @default("{}")
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  sales_orders           sales_orders[]
  from_transfer_requests stock_transfer_requests[] @relation("FromBranch")
  to_transfer_requests   stock_transfer_requests[] @relation("ToBranch")
  inventory              branch_inventory[]
  storage_bins           storage_bins[]
  stock_adjustments      stock_adjustments[]       @relation("Branch")
  stock_ledgers          product_stock_ledgers[]

  @@index([code])
  @@map("branches")
}

model storage_bins {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  code      String   @db.VarChar(20)
  branch_id String
  location  String?  @db.VarChar(100)
  capacity  Int?
  is_active Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  branch    branches          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  inventory branch_inventory[]

  @@unique([branch_id, code])
  @@index([branch_id])
  @@map("storage_bins")
}

model branch_inventory {
  id               String   @id @default(cuid())
  branch_id        String
  variation_id     String
  bin_id           String?
  stock_quantity   Int      @default(0)
  reserved_quantity Int     @default(0)
  min_stock_level  Int      @default(0)
  max_stock_level  Int?
  last_counted_at  DateTime? @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  branch    branches          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  variation product_variations @relation(fields: [variation_id], references: [id], onDelete: Cascade)
  bin       storage_bins?     @relation(fields: [bin_id], references: [id], onDelete: SetNull)

  @@unique([branch_id, variation_id])
  @@index([branch_id])
  @@index([variation_id])
  @@index([stock_quantity])
  @@map("branch_inventory")
}

// ================== STOCK OPERATIONS ==================
model stock_transfer_requests {
  id               String          @id @default(cuid())
  request_number   String          @unique @db.VarChar(20)
  from_branch_id   String
  to_branch_id     String
  requested_by     String
  status           transfer_status @default(PENDING)
  priority         priority_level  @default(NORMAL)
  notes            String?         @db.Text
  requested_at     DateTime        @default(now()) @db.Timestamptz(6)
  approved_at      DateTime?       @db.Timestamptz(6)
  completed_at     DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  // Relations
  from_branch branches               @relation("FromBranch", fields: [from_branch_id], references: [id])
  to_branch   branches               @relation("ToBranch", fields: [to_branch_id], references: [id])
  requester   employees              @relation("RequestedBy", fields: [requested_by], references: [id])
  items       stock_transfer_items[]
  deliveries  deliveries[]
  logs        stock_transfer_logs[]

  @@index([request_number])
  @@index([from_branch_id])
  @@index([to_branch_id])
  @@index([status])
  @@map("stock_transfer_requests")
}

model stock_transfer_items {
  id                String   @id @default(cuid())
  transfer_request_id String
  variation_id       String
  quantity_requested Int
  quantity_approved  Int?
  quantity_dispatched Int?
  quantity_received  Int?
  notes             String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  transfer_request stock_transfer_requests @relation(fields: [transfer_request_id], references: [id], onDelete: Cascade)
  variation        product_variations      @relation(fields: [variation_id], references: [id], onDelete: Cascade)

  @@unique([transfer_request_id, variation_id])
  @@map("stock_transfer_items")
}

model deliveries {
  id                  String          @id @default(cuid())
  delivery_number     String          @unique @db.VarChar(20)
  transfer_request_id String
  dispatched_by       String
  received_by         String?
  delivery_method     delivery_method
  tracking_number     String?         @db.VarChar(50)
  dispatch_time       DateTime?       @db.Timestamptz(6)
  estimated_arrival   DateTime?       @db.Timestamptz(6)
  received_time       DateTime?       @db.Timestamptz(6)
  delivery_notes      String?         @db.Text
  status              delivery_status @default(PENDING)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @updatedAt @db.Timestamptz(6)

  // Relations
  transfer_request stock_transfer_requests @relation(fields: [transfer_request_id], references: [id], onDelete: Cascade)
  dispatcher       employees               @relation("DispatchedBy", fields: [dispatched_by], references: [id])
  receiver         employees?              @relation("ReceivedBy", fields: [received_by], references: [id])

  @@index([delivery_number])
  @@index([transfer_request_id])
  @@map("deliveries")
}

model stock_transfer_logs {
  id                  String          @id @default(cuid())
  transfer_request_id String
  employee_id         String
  action_type         transfer_status
  notes               String?         @db.Text
  metadata            Json?           @default("{}")
  created_at          DateTime        @default(now()) @db.Timestamptz(6)

  // Relations
  transfer_request stock_transfer_requests @relation(fields: [transfer_request_id], references: [id], onDelete: Cascade)
  employee         employees               @relation(fields: [employee_id], references: [id])

  @@index([transfer_request_id])
  @@index([employee_id])
  @@map("stock_transfer_logs")
}

model stock_adjustments {
  id              String            @id @default(cuid())
  adjustment_number String          @unique @db.VarChar(20)
  branch_id       String
  variation_id    String
  quantity_before Int
  quantity_after  Int
  quantity_change Int
  reason          adjustment_reason
  notes           String?           @db.Text
  adjusted_by     String
  approved_by     String?
  adjustment_date DateTime          @default(now()) @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)

  // Relations
  branch    branches          @relation("Branch", fields: [branch_id], references: [id])
  variation product_variations @relation("ProductVariation", fields: [variation_id], references: [id])
  adjuster  employees         @relation("AdjustedBy", fields: [adjusted_by], references: [id])

  @@index([adjustment_number])
  @@index([branch_id])
  @@index([variation_id])
  @@map("stock_adjustments")
}

// ================== SUPPLIER & PURCHASE MANAGEMENT ==================
model suppliers {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(10)
  contact_name String?  @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(255)
  address      String?  @db.Text
  tax_number   String?  @db.VarChar(20)
  payment_terms String? @db.VarChar(100)
  credit_limit Decimal? @db.Decimal(12, 2)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  
  // Relations
  purchase_orders purchase_orders[]

  @@index([code])
  @@index([name])
  @@map("suppliers")
}

model purchase_orders {
  id             String        @id @default(cuid())
  order_number   String        @unique @db.VarChar(20)
  supplier_id    String
  purchased_by   String?
  order_date     DateTime      @default(now()) @db.Date
  expected_date  DateTime?     @db.Date
  received_date  DateTime?     @db.Date
  status         order_status  @default(PENDING)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  tax_amount     Decimal       @default(0) @db.Decimal(10, 2)
  total_amount   Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?       @db.Text
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @updatedAt @db.Timestamptz(6)
  
  // Relations
  supplier suppliers             @relation(fields: [supplier_id], references: [id])
  user     users?                @relation(fields: [purchased_by], references: [id])
  items    purchase_order_items[]
  returns  purchase_returns[]

  @@index([order_number])
  @@index([supplier_id])
  @@index([status])
  @@map("purchase_orders")
}

model purchase_order_items {
  id               String   @id @default(cuid())
  purchase_order_id String
  variation_id     String
  quantity_ordered Int
  quantity_received Int     @default(0)
  cost_price       Decimal  @db.Decimal(10, 2)
  wholesale_price  Decimal? @db.Decimal(10, 2)
  retail_price     Decimal? @db.Decimal(10, 2)
  line_total       Decimal  @db.Decimal(12, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  purchase_order purchase_orders    @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  variation      product_variations @relation(fields: [variation_id], references: [id])

  @@unique([purchase_order_id, variation_id])
  @@map("purchase_order_items")
}

model purchase_returns {
  id                String   @id @default(cuid())
  return_number     String   @unique @db.VarChar(20)
  purchase_order_id String
  returned_by       String
  return_date       DateTime @default(now()) @db.Date
  reason            String?  @db.Text
  total_amount      Decimal  @default(0) @db.Decimal(12, 2)
  status            return_status @default(PENDING)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  purchase_order purchase_orders        @relation(fields: [purchase_order_id], references: [id])
  items          purchase_return_items[]

  @@index([return_number])
  @@index([purchase_order_id])
  @@map("purchase_returns")
}

model purchase_return_items {
  id                 String   @id @default(cuid())
  purchase_return_id String
  variation_id       String
  quantity           Int
  cost_price         Decimal  @db.Decimal(10, 2)
  line_total         Decimal  @db.Decimal(12, 2)
  reason             String?  @db.Text
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  purchase_return purchase_returns     @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade)
  variation       product_variations   @relation(fields: [variation_id], references: [id])

  @@unique([purchase_return_id, variation_id])
  @@map("purchase_return_items")
}

// ================== CUSTOMER & SALES MANAGEMENT ==================
model customers {
  id           String   @id @default(cuid())
  customer_number String @unique @db.VarChar(20)
  name         String   @db.VarChar(100)
  email        String?  @unique @db.VarChar(255)
  nic          String?  @unique @db.VarChar(20)
  phone        String?  @unique @db.VarChar(20)
  address      String?  @db.Text
  date_of_birth DateTime? @db.Date
  credit_limit Decimal? @db.Decimal(12, 2)
  outstanding_balance Decimal @default(0) @db.Decimal(12, 2)
  loyalty_points Int    @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  
  // Relations
  sales_orders sales_orders[]

  @@index([customer_number])
  @@index([phone])
  @@index([email])
  @@map("customers")
}

model sales_orders {
  id            String       @id @default(cuid())
  order_number  String       @unique @db.VarChar(20)
  customer_id   String
  branch_id     String
  order_date    DateTime     @default(now()) @db.Timestamptz(6)
  due_date      DateTime?    @db.Date
  status        order_status @default(PENDING)
  payment_status payment_status @default(PENDING)
  payment_method payment_method?
  subtotal      Decimal      @default(0) @db.Decimal(12, 2)
  discount_amount Decimal    @default(0) @db.Decimal(10, 2)
  tax_amount    Decimal      @default(0) @db.Decimal(10, 2)
  total_amount  Decimal      @default(0) @db.Decimal(12, 2)
  paid_amount   Decimal      @default(0) @db.Decimal(12, 2)
  notes         String?      @db.Text
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)

  // Relations
  customer customers         @relation(fields: [customer_id], references: [id])
  branch   branches          @relation(fields: [branch_id], references: [id])
  items    sales_order_items[]
  returns  sales_returns[]

  @@index([order_number])
  @@index([customer_id])
  @@index([branch_id])
  @@index([status])
  @@index([order_date])
  @@map("sales_orders")
}

model sales_order_items {
  id             String   @id @default(cuid())
  sales_order_id String
  variation_id   String
  quantity       Int
  unit_price     Decimal  @db.Decimal(10, 2)
  discount_amount Decimal @default(0) @db.Decimal(10, 2)
  line_total     Decimal  @db.Decimal(12, 2)
  serial_numbers String?  @db.Text // JSON array of serial numbers
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  sales_order sales_orders       @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  variation   product_variations @relation(fields: [variation_id], references: [id])

  @@unique([sales_order_id, variation_id])
  @@map("sales_order_items")
}

model sales_returns {
  id             String        @id @default(cuid())
  return_number  String        @unique @db.VarChar(20)
  sales_order_id String
  returned_by    String
  return_date    DateTime      @default(now()) @db.Date
  reason         return_reason
  notes          String?       @db.Text
  total_amount   Decimal       @default(0) @db.Decimal(12, 2)
  refund_amount  Decimal       @default(0) @db.Decimal(12, 2)
  status         return_status @default(PENDING)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @updatedAt @db.Timestamptz(6)

  // Relations
  sales_order sales_orders        @relation(fields: [sales_order_id], references: [id])
  items       sales_return_items[]

  @@index([return_number])
  @@index([sales_order_id])
  @@map("sales_returns")
}

model sales_return_items {
  id              String   @id @default(cuid())
  sales_return_id String
  variation_id    String
  quantity        Int
  unit_price      Decimal  @db.Decimal(10, 2)
  line_total      Decimal  @db.Decimal(12, 2)
  serial_numbers  String?  @db.Text // JSON array of serial numbers
  condition       item_condition @default(GOOD)
  notes           String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  sales_return sales_returns      @relation(fields: [sales_return_id], references: [id], onDelete: Cascade)
  variation    product_variations @relation(fields: [variation_id], references: [id])

  @@unique([sales_return_id, variation_id])
  @@map("sales_return_items")
}

