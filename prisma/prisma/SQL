-- 6. UTILITY FUNCTIONS

-- Clean up old daily sequences (keep last 30 days)
CREATE OR REPLACE FUNCTION cleanup_old_sequences()
RETURNS INTEGER AS $$
DECLARE
  deleted_count INTEGER;
BEGIN
  DELETE FROM code_sequences 
  WHERE sequence_key NOT LIKE '%_global'
    AND updated_at < CURRENT_DATE - INTERVAL '30 days';
    
  GET DIAGNOSTICS deleted_count = ROW_COUNT;
  RETURN deleted_count;
END;
$$ LANGUAGE plpgsql;

-- Preview next number without incrementing (UPDATED FOR DYNAMIC LENGTH)
CREATE OR REPLACE FUNCTION preview_next_number(
  prefix TEXT,
  include_date BOOLEAN DEFAULT true,
  use_padding BOOLEAN DEFAULT false,
  sequence_length INTEGER DEFAULT 6
)
RETURNS TEXT AS $
DECLARE
  today TEXT := TO_CHAR(CURRENT_DATE, 'YYYYMMDD');
  seq_key TEXT;
  current_val INTEGER;
  next_val INTEGER;
  order_number TEXT;
  number_part TEXT;
BEGIN
  -- Create sequence key
  IF include_date THEN
    seq_key := LOWER(prefix) || '_' || today;
  ELSE
    seq_key := LOWER(prefix) || '_global';
  END IF;
  
  -- Get current value
  SELECT current_value INTO current_val
  FROM code_sequences
  WHERE sequence_key = seq_key;
  
  -- If no sequence exists, next will be 1
  next_val := COALESCE(current_val, 0) + 1;
  
  -- Format number part (with or without padding)
  IF use_padding THEN
    number_part := LPAD(next_val::TEXT, sequence_length, '0');
  ELSE
    number_part := next_val::TEXT;
  END IF;
  
  -- Build order number
  IF include_date THEN
    order_number := prefix || '-' || today || '-' || number_part;
  ELSE
    order_number := prefix || '-' || number_part;
  END IF;
  
  RETURN order_number;
END;
$ LANGUAGE plpgsql;

-- Reset sequence for a specific key (UPDATED)
CREATE OR REPLACE FUNCTION reset_sequence(
  prefix TEXT,
  include_date BOOLEAN DEFAULT true,
  reset_value INTEGER DEFAULT 0
)
RETURNS BOOLEAN AS $
DECLARE
  today TEXT := TO_CHAR(CURRENT_DATE, 'YYYYMMDD');
  seq_key TEXT;
BEGIN
  -- Create sequence key
  IF include_date THEN
    seq_key := LOWER(prefix) || '_' || today;
  ELSE
    seq_key := LOWER(prefix) || '_global';
  END IF;
  
  -- Update or insert the sequence
  INSERT INTO code_sequences (sequence_key, current_value, updated_at)
  VALUES (seq_key, reset_value, NOW())
  ON CONFLICT (sequence_key) 
  DO UPDATE SET 
    current_value = reset_value,
    updated_at = NOW();
    
  RETURN true;
END;
$ LANGUAGE plpgsql;

-- Get all active sequences with their current values
CREATE OR REPLACE VIEW v_sequence_status AS
SELECT 
  sequence_key,
  current_value,
  CASE 
    WHEN sequence_key LIKE '%_global' THEN 'Global'
    ELSE 'Daily (' || RIGHT(sequence_key, 8) || ')'
  END as sequence_type,
  created_at,
  updated_at
FROM code_sequences
ORDER BY sequence_key;

